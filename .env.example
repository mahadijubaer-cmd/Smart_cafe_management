# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://scms:scms@postgres:5432/scms

# ── JWT Auth ──────────────────────────────────────────────────
SECRET_KEY=replace_with_64_char_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── SMTP (Email / OTP) ────────────────────────────────────────
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=SCMS Platform
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
PLATFORM_NAME=SCMS
MEDIA_DIR=/app/media
