# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://scms:scms@postgres:5432/scms
# Production: use a strong password and match POSTGRES_PASSWORD below
POSTGRES_PASSWORD=scms_prod_secret

# ── JWT Auth ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_char_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── Email / OTP — Brevo (preferred provider, see ADR-007) ─────
# When BREVO_API_KEY is set, all OTP/invite/QR emails go through Brevo's API.
# MAIL_FROM must be a verified sender in the Brevo account.
BREVO_API_KEY=
MAIL_FROM=your_verified_sender@example.com
MAIL_FROM_NAME=SCMS Platform

# ── SMTP — legacy fallback, used only if BREVO_API_KEY is empty ──
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
# Development alternative — Mailtrap intercepts all outgoing mail:
# MAIL_SERVER=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (JSON array string)
CORS_ORIGINS=["http://localhost:3000"]
# Production example: CORS_ORIGINS=["https://cafe.yourdomain.com"]

# ── Object storage — Backblaze B2 (S3-compatible), for tenant logos / menu images ──
# Leave all four blank for local dev — storage_service.py falls back to local disk under
# MEDIA_ROOT. Required wherever the filesystem is ephemeral (e.g. Render's free tier).
B2_ENDPOINT_URL=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Public base URL for the bucket, e.g. https://f005.backblazeb2.com/file/scms-media
B2_PUBLIC_URL_BASE=

# ── App ───────────────────────────────────────────────────────
# WARNING: pydantic Settings REJECTS unknown keys — only add variables that exist as fields in
# backend/app/core/config.py, or the backend crashes at startup.
ENVIRONMENT=development
# Set to false in production (disables SQLAlchemy echo, enables stricter error handling)
DEBUG=true
MEDIA_ROOT=/app/media
# Public URL of the frontend — baked into table-QR payloads (qr_service). MUST be set to the real
# public origin in production or printed QR codes point at a dead domain.
FRONTEND_URL=http://localhost:3000

# ── Production server ─────────────────────────────────────────
# Used by docker-compose.prod.yml to build public-facing URLs
SERVER_HOST=localhost
# Production example: SERVER_HOST=cafe.yourdomain.com

# ── pgAdmin (production only) ─────────────────────────────────
# Accessible at http://SERVER_HOST:5050
PGADMIN_EMAIL=admin@scms.local
PGADMIN_PASSWORD=pgadmin_secret
